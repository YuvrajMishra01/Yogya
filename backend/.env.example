# Yogya Backend Environment Configuration

# API Settings
PROJECT_NAME="Yogya Compliance API"
API_V1_STR="/api/v1"
SECRET_KEY="yogya-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Database Settings
# Default PostgreSQL URL (asyncpg):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/yogya_db"
# SQLite fallback URL for development/testing:
# DATABASE_URL="sqlite+aiosqlite:///./yogya.db"

# Storage Settings
UPLOAD_DIR="./uploads"

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
